<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.MicroServe" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/admin_primary_purple</item>
        <item name="colorPrimaryVariant">@color/admin_purple_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/admin_bg_light</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Navigation bar matches the dark bottom nav -->
        <item name="android:navigationBarColor">#151030</item>
    </style>
</resources>

