<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/wallet_dialog_bg"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="28dp">

    <!-- Handle bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/rounded_white_43dp" />

    <!-- Title row with coin -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="12dp">

            <View
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/ic_m_coin" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="M"
                android:textColor="#FFD700"
                android:textSize="16sp"
                android:includeFontPadding="false" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:text="Add M Points"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- Current balance -->
    <TextView
        android:id="@+id/tv_current_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="Current balance: M 10,500"
        android:textColor="#B8A8E0"
        android:textSize="13sp" />

    <!-- Amount input label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Enter amount to add"
        android:textColor="#C4B5E0"
        android:textSize="14sp" />

    <!-- Amount input field -->
    <EditText
        android:id="@+id/et_amount"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/wallet_input_bg"
        android:fontFamily="sans-serif-bold"
        android:gravity="center_vertical"
        android:hint="e.g. 1000"
        android:inputType="number"
        android:paddingHorizontal="20dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#665A80"
        android:textSize="18sp" />

    <!-- Quick amount chips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chip_500"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/wallet_chip_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="500"
            android:textColor="#C4B5E0"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chip_1000"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/wallet_chip_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="1,000"
            android:textColor="#C4B5E0"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chip_2000"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/wallet_chip_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="2,000"
            android:textColor="#C4B5E0"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chip_5000"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/wallet_chip_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="5,000"
            android:textColor="#C4B5E0"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Card info -->
    <LinearLayout
        android:id="@+id/card_info_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:background="@drawable/wallet_input_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="20dp"
            android:layout_marginEnd="12dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/wallet" />

        <TextView
            android:id="@+id/tv_card_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="•••• •••• •••• 1234"
            android:textColor="#C4B5E0"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- No card warning -->
    <TextView
        android:id="@+id/tv_no_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:text="⚠️ Please add a card first"
        android:textColor="#FFB347"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Add to Wallet button -->
    <FrameLayout
        android:id="@+id/btn_add_to_wallet"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/wallet_button_gradient"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:elevation="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="sans-serif-bold"
            android:text="Add to Your Wallet"
            android:textColor="@color/white"
            android:textSize="16sp" />
    </FrameLayout>

</LinearLayout>
