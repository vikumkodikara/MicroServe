<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_background"
    tools:context=".SplashActivity">

    <com.example.microserve.ParticleView
        android:id="@+id/particleView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:id="@+id/splashGlow"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:alpha="0"
            android:background="@drawable/splash_logo_glow"
            app:layout_constraintBottom_toBottomOf="@id/splashLogo"
            app:layout_constraintEnd_toEndOf="@id/splashLogo"
            app:layout_constraintStart_toStartOf="@id/splashLogo"
            app:layout_constraintTop_toTopOf="@id/splashLogo" />

        <ImageView
            android:id="@+id/splashLogo"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:alpha="0"
            android:contentDescription="@string/cd_login_logo"
            android:scaleType="fitCenter"
            android:src="@drawable/logo"
            app:layout_constraintBottom_toTopOf="@id/splashAppName"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.38"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/splashAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:alpha="0"
            android:fontFamily="sans-serif-light"
            android:includeFontPadding="false"
            android:letterSpacing="0.15"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="28sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/splashLogo" />

        <TextView
            android:id="@+id/splashTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:alpha="0"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.08"
            android:text="Services at your doorstep"
            android:textColor="#B0FFFFFF"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/splashAppName" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/splashProgress"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="64dp"
            android:alpha="0"
            android:indeterminate="true"
            app:indicatorColor="#B39DDB"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:trackColor="#22FFFFFF"
            app:trackCornerRadius="2dp"
            app:trackThickness="3dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
