<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/admin_bg_light"
    tools:context=".EditPostActivity">

    <!-- ═══════════ HEADER ═══════════ -->
    <RelativeLayout
        android:id="@+id/headerContainer"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:background="@drawable/header_gradient"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/backBtn"
            android:layout_marginTop="42dp"
            android:text="Edit Post"
            android:textColor="@color/white"
            android:textSize="35sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/backBtn"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="Back"
            android:padding="6dp"
            android:src="@drawable/back_arrow" />

    </RelativeLayout>

    <!-- ═══════════ BLACK BORDERED CARD ═══════════ -->
    <FrameLayout
        android:id="@+id/blackFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/post_form_card"
        android:padding="2dp"
        app:layout_constraintBottom_toTopOf="@id/footerBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerContainer">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="120dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/deleteBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_gravity="center_horizontal"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="32dp"
                    android:text="Delete Post"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="#DC3545"
                    app:cornerRadius="32dp"
                    app:rippleColor="#33FFFFFF"
                    app:strokeWidth="0dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Service Category"
                    android:textColor="@color/admin_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/categorySpinner"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/spinner_dropdown_bg"
                    android:paddingHorizontal="10dp"
                    android:spinnerMode="dropdown" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Name of the Service Provider"
                    android:textColor="@color/admin_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/providerNameET"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/edittext_bg"
                    android:hint="Enter provider name"
                    android:inputType="textPersonName"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/admin_text_primary"
                    android:textColorHint="@color/admin_text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/post_ads_add_image_label"
                    android:textColor="@color/admin_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/post_ads_image_crop_hint"
                    android:textColor="@color/admin_text_secondary"
                    android:textSize="12sp" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/addImageBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/admin_quick_action_bg"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#D8D2E8"
                    app:strokeWidth="1dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <View
                            android:id="@+id/imageSquareGuide"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="invisible"
                            app:layout_constraintDimensionRatio="1:1"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/selectedImagePreview"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:background="@color/admin_quick_action_bg"
                            android:contentDescription="Selected image"
                            android:scaleType="centerCrop"
                            android:src="@drawable/home_job_done_placeholder"
                            app:layout_constraintBottom_toBottomOf="@id/imageSquareGuide"
                            app:layout_constraintEnd_toEndOf="@id/imageSquareGuide"
                            app:layout_constraintStart_toStartOf="@id/imageSquareGuide"
                            app:layout_constraintTop_toTopOf="@id/imageSquareGuide" />

                        <LinearLayout
                            android:id="@+id/addImagePlaceholder"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="16dp"
                            app:layout_constraintBottom_toBottomOf="@id/imageSquareGuide"
                            app:layout_constraintEnd_toEndOf="@id/imageSquareGuide"
                            app:layout_constraintStart_toStartOf="@id/imageSquareGuide"
                            app:layout_constraintTop_toTopOf="@id/imageSquareGuide">

                            <ImageView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:contentDescription="Gallery Icon"
                                android:src="@android:drawable/ic_menu_gallery"
                                app:tint="@color/brand_purple" />

                            <TextView
                                android:id="@+id/imageActionText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/post_ads_add_image"
                                android:textColor="@color/admin_text_secondary"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvImageChangeHint"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:background="@drawable/ad_card_image_scrim"
                            android:gravity="center"
                            android:paddingVertical="8dp"
                            android:text="@string/post_ads_change_image"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:visibility="gone"
                            app:layout_constraintBottom_toBottomOf="@id/imageSquareGuide"
                            app:layout_constraintEnd_toEndOf="@id/imageSquareGuide"
                            app:layout_constraintStart_toStartOf="@id/imageSquareGuide" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Location"
                    android:textColor="@color/admin_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/locationET"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/edittext_bg"
                    android:hint="Enter location"
                    android:inputType="textPostalAddress"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/admin_text_primary"
                    android:textColorHint="@color/admin_text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Contact"
                    android:textColor="@color/admin_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/contactET"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/edittext_bg"
                    android:hint="Enter contact number"
                    android:inputType="phone"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/admin_text_primary"
                    android:textColorHint="@color/admin_text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Email"
                    android:textColor="@color/admin_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/emailET"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/edittext_bg"
                    android:hint="Enter email address"
                    android:inputType="textEmailAddress"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/admin_text_primary"
                    android:textColorHint="@color/admin_text_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/saveBtn"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="16dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Save Changes"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="#28A745"
                    app:cornerRadius="14dp"
                    app:rippleColor="#33FFFFFF" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </FrameLayout>

    <!-- ═══════════ FOOTER BAR ═══════════ -->
    <View
        android:id="@+id/footerBar"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="@drawable/footer_gradient_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
