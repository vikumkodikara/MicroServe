<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/requestDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".RequestDetailActivity">

    <ScrollView
        android:id="@+id/contentScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/footerBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <RelativeLayout
                android:id="@+id/headerSection"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:background="@drawable/header_gradient"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:paddingHorizontal="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="14dp">

                <ImageView
                    android:id="@+id/backBtn"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:contentDescription="@string/cd_back"
                    android:padding="6dp"
                    android:src="@drawable/back_arrow" />

                <ImageView
                    android:id="@+id/requesterAvatar"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    tools:src="@drawable/plumber" />

                <TextView
                    android:id="@+id/requesterNameText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/backBtn"
                    android:layout_alignParentStart="true"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="12dp"
                    android:layout_toStartOf="@id/requesterAvatar"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-bold"
                    android:maxLines="2"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    tools:text="Sisira Kumara" />

                <TextView
                    android:id="@+id/requesterAgeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/requesterNameText"
                    android:layout_alignParentStart="true"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="12dp"
                    android:layout_toStartOf="@id/requesterAvatar"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#E8E0F0"
                    android:textSize="14sp"
                    tools:text="Colombo" />
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/detailsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/post_form_card"
                android:orientation="vertical"
                android:padding="20dp">

                    <TextView
                        android:id="@+id/detailsTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="@string/service_request_details"
                        android:textColor="#1A1A1A"
                        android:textSize="18sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="4dp"
                        android:background="#E8E8E8" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/service_label"
                        android:textColor="#1A1A1A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/serviceValueText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="#777777"
                        android:textSize="15sp"
                        tools:text="Painting" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/location_label"
                        android:textColor="#1A1A1A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/locationValueText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="#777777"
                        android:textSize="15sp"
                        tools:text="Near to Lake, Kuliyapitiya, Kurunegala" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/job_label"
                        android:textColor="#1A1A1A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/jobValueText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="#777777"
                        android:textSize="15sp"
                        tools:text="Painting My House" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/status_label"
                        android:textColor="#1A1A1A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/statusValueText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/purple_dark"
                        android:textSize="15sp"
                        tools:text="Open" />

                    <TextView
                        android:id="@+id/bidButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_gravity="end"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/rounded_purple_24dp"
                        android:gravity="center"
                        android:minWidth="88dp"
                        android:paddingHorizontal="20dp"
                        android:text="@string/bid_button"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/proceedPaymentButton"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/rounded_purple_24dp"
                        android:gravity="center"
                        android:text="@string/proceed_payment"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/finishedButton"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/rounded_purple_24dp"
                        android:gravity="center"
                        android:text="@string/finished_button"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

            </LinearLayout>

            <TextView
                android:id="@+id/previousBidsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-bold"
                android:text="@string/previous_bids"
                android:textColor="#1A1A1A"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/bidsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="20dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <View
        android:id="@+id/footerBar"
        android:layout_width="0dp"
        android:layout_height="38dp"
        android:background="@drawable/footer_gradient_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
