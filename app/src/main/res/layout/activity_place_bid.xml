<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Header -->
    <RelativeLayout
        android:id="@+id/header_bg"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@drawable/header_gradient"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:importantForAccessibility="no"
            android:padding="6dp"
            android:src="@drawable/back_arrow" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/btn_back"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-bold"
            android:text="Place a\nbid"
            android:textColor="#FFFFFF"
            android:textSize="30sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="#E8E0F0"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/request" />
        </com.google.android.material.card.MaterialCardView>
    </RelativeLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp">

            <!-- Bid Form Card -->
            <FrameLayout
                android:id="@+id/bidFormCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/post_form_card"
                android:padding="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Bid Amount"
                        android:textColor="#1A1A1A"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_bid_amount"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/edittext_bg"
                        android:hint="Rs."
                        android:inputType="number"
                        android:paddingHorizontal="16dp"
                        android:textColor="#1A1A1A"
                        android:textColorHint="#999999"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Completion Time"
                        android:textColor="#1A1A1A"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_completion_time"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginBottom="18dp"
                        android:background="@drawable/edittext_bg"
                        android:hint="xxxxh"
                        android:inputType="text"
                        android:paddingHorizontal="16dp"
                        android:textColor="#1A1A1A"
                        android:textColorHint="#999999"
                        android:textSize="14sp" />

                    <!-- Checkbox -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <CheckBox
                            android:id="@+id/cb_agree"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="#4a4458" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="I agree to terms"
                            android:textColor="#1A1A1A"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Place Bid Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_place_bid"
                        android:layout_width="180dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center_horizontal"
                        android:backgroundTint="#4a4458"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="PLACE BID"
                        android:textAllCaps="true"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:cornerRadius="22dp" />

                </LinearLayout>
            </FrameLayout>

            <!-- Previous Bids Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="sans-serif-bold"
                android:text="Previous bids"
                android:textColor="#1A1A1A"
                android:textSize="16sp" />

            <!-- Previous Bids List -->
            <LinearLayout
                android:id="@+id/bidsListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

    <!-- Footer Bar -->
    <View
        android:id="@+id/footerBar"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@drawable/footer_gradient_bar" />

</LinearLayout>
