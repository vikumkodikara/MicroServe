<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Header -->
    <FrameLayout
        android:id="@+id/header_bg"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:background="@drawable/header_gradient">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="36dp">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:padding="2dp"
                android:src="@drawable/back_arrow" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-bold"
                android:text="Create Feedback"
                android:textColor="#FFFFFF"
                android:textSize="26sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:alpha="0.85"
                android:text="Share your experience with us"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            android:paddingTop="28dp"
            android:paddingBottom="20dp">

            <!-- Rating Section Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="14dp"
                android:text="How would you rate us?"
                android:textColor="#2D3436"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Star Rating -->
            <LinearLayout
                android:id="@+id/starsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/star1"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:importantForAccessibility="no"
                    android:src="@android:drawable/btn_star_big_on"
                    app:tint="@color/star_unselected" />

                <ImageView
                    android:id="@+id/star2"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:importantForAccessibility="no"
                    android:src="@android:drawable/btn_star_big_on"
                    app:tint="@color/star_unselected" />

                <ImageView
                    android:id="@+id/star3"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:importantForAccessibility="no"
                    android:src="@android:drawable/btn_star_big_on"
                    app:tint="@color/star_unselected" />

                <ImageView
                    android:id="@+id/star4"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:importantForAccessibility="no"
                    android:src="@android:drawable/btn_star_big_on"
                    app:tint="@color/star_unselected" />

                <ImageView
                    android:id="@+id/star5"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:importantForAccessibility="no"
                    android:src="@android:drawable/btn_star_big_on"
                    app:tint="@color/star_unselected" />
            </LinearLayout>

            <!-- Rating label (Tap to rate) -->
            <TextView
                android:id="@+id/tvRatingHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="28dp"
                android:text="Tap a star to rate"
                android:textColor="#999999"
                android:textSize="12sp" />

            <!-- Feedback Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Feedback"
                android:textColor="#2D3436"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_feedback"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="28dp"
                android:background="@drawable/login_field_bg"
                android:gravity="top|start"
                android:hint="Share your experience..."
                android:inputType="textMultiLine"
                android:paddingHorizontal="16dp"
                android:paddingTop="14dp"
                android:textColor="#1A1A1A"
                android:textColorHint="#B3B3B3"
                android:textSize="14sp" />

            <!-- Create Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_create"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="#6C5CE7"
                android:text="Submit Feedback"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="26dp"
                app:icon="@android:drawable/ic_menu_send"
                app:iconGravity="textEnd"
                app:iconTint="@android:color/white" />

        </LinearLayout>
    </ScrollView>

    <!-- Footer Bar -->
    <View
        android:id="@+id/footerBar"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@drawable/footer_gradient_bar" />

</LinearLayout>
