<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/categoryDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical">

    <!-- Header -->
    <RelativeLayout
        android:id="@+id/header_bg"
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:background="@drawable/header_gradient"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="14dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:importantForAccessibility="no"
            android:padding="6dp"
            android:src="@drawable/back_arrow" />

        <ImageView
            android:id="@+id/iv_category_icon"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/request" />

        <TextView
            android:id="@+id/tv_category_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/btn_back"
            android:layout_alignParentStart="true"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"
            android:layout_toStartOf="@id/iv_category_icon"
            android:ellipsize="end"
            android:fontFamily="sans-serif-bold"
            android:maxLines="2"
            android:text="Plumbing"
            android:textColor="#FFFFFF"
            android:textSize="26sp" />
    </RelativeLayout>

    <!-- Category Chips -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="10dp"
        android:fontFamily="sans-serif-bold"
        android:text="Category"
        android:textColor="#1A1A1A"
        android:textSize="16sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/chipsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Providers List -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="20dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/providersContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Footer Bar -->
    <View
        android:id="@+id/footerBar"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@drawable/footer_gradient_bar" />

</LinearLayout>
