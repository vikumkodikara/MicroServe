<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/usersRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/admin_bg_light"
    android:orientation="vertical"
    tools:context=".UsersActivity">

    <!-- ═══════════ HEADER ═══════════ -->
    <FrameLayout
        android:id="@+id/usersHeaderFrame"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:background="@drawable/sub_header_gradient">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- Back arrow + Title -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="‹"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:paddingEnd="12dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Users"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>
    </FrameLayout>

    <!-- ═══════════ TAB BUTTONS (HORIZONTAL SCROLL) ═══════════ -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:spacing="8dp">

            <Button
                android:id="@+id/tabAll"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:paddingHorizontal="18dp"
                android:background="@drawable/tab_active_bg"
                android:text="All"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/tabProviders"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:paddingHorizontal="18dp"
                android:background="@drawable/tab_inactive_bg"
                android:text="Providers"
                android:textColor="@color/admin_text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/tabRequesters"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:paddingHorizontal="18dp"
                android:background="@drawable/tab_inactive_bg"
                android:text="Requesters"
                android:textColor="@color/admin_text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/tabActive"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:paddingHorizontal="18dp"
                android:background="@drawable/tab_inactive_bg"
                android:text="Active"
                android:textColor="@color/admin_text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/tabInactive"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:paddingHorizontal="18dp"
                android:background="@drawable/tab_inactive_bg"
                android:text="Inactive"
                android:textColor="@color/admin_text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:stateListAnimator="@null" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- ═══════════ USERS LIST ═══════════ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvUsers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        tools:listitem="@layout/item_user_card" />

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👤"
            android:textSize="60sp" />

        <TextView
            android:id="@+id/emptyStateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="No Users"
            android:textColor="@color/admin_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- ═══════════ BOTTOM NAVIGATION ═══════════ -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/admin_bottom_nav_bg"
        android:elevation="10dp"
        app:itemIconTint="@color/white"
        app:itemTextColor="@color/white"
        app:menu="@menu/admin_bottom_nav_menu" />

</LinearLayout>
