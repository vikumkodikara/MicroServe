<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Light highlight (top-left): -10px -10px 30px #FFFFFF -->
    <item
        android:bottom="6dp"
        android:right="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="27dp" />
        </shape>
    </item>
    <!-- Dark shadow (bottom-right): 10px 10px 30px #AEAEC0 at 40% -->
    <item
        android:left="6dp"
        android:top="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#66AEAEC0" />
            <corners android:radius="27dp" />
        </shape>
    </item>
    <!-- Main surface #F0F0F3 -->
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#F0F0F3" />
            <corners android:radius="27dp" />
        </shape>
    </item>
</layer-list>
