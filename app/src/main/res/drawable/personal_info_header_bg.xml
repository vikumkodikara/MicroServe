<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Rectangle for the top portion -->
    <item android:bottom="60dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#7A6BB3"
                android:endColor="#483C72"
                android:type="linear" />
        </shape>
    </item>
    <!-- Oval for the curved bottom portion (purple bulging down) -->
    <item
        android:top="60dp"
        android:left="-30dp"
        android:right="-30dp"
        android:bottom="-30dp">
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#7A6BB3"
                android:endColor="#483C72"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
