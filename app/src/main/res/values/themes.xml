<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.MicroServe" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/admin_primary_purple</item>
        <item name="colorPrimaryVariant">@color/admin_purple_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/admin_purple_light</item>
        <item name="colorSecondaryVariant">@color/admin_purple_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar blends with the purple header gradient -->
        <item name="android:statusBarColor">@color/white</item>
        <!-- Navigation bar matches the bottom nav -->
        <item name="android:navigationBarColor">#3A2B52</item>
        <!-- Light status bar icons (white icons on dark purple bg) -->
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
    </style>

    <style name="Theme.MicroServe.Splash" parent="Theme.MicroServe">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#050208</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
    </style>

    <style name="Theme.MicroServe.Login" parent="Theme.MicroServe">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
    </style>

    <style name="Widget.MicroServe.LoginButton" parent="Widget.MaterialComponents.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="backgroundTint">@color/login_button_lavender</item>
        <item name="cornerRadius">30dp</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">#33FFFFFF</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="DayChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/day_chip_selector</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">6dp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

</resources>
